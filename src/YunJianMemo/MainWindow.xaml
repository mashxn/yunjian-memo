<Window x:Class="YunJianMemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:YunJianMemo.Controls"
        Title="云笺 · 桌面备忘录"
        Width="420" Height="700" MinWidth="380" MinHeight="520"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded" Closing="Window_Closing"
        Icon="Assets/app.ico">

    <Window.Resources>

        <DataTemplate x:Key="TaskMiniTemplate">
            <Border Background="Transparent" Padding="0,4" MinHeight="38" Cursor="Hand"
                    MouseLeftButtonUp="TaskRow_Click" ToolTip="{Binding DueFull}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Style="{StaticResource TaskCheck}" IsChecked="{Binding IsDone, Mode=TwoWay}"
                              VerticalAlignment="Center" Click="TaskCheck_Click" ToolTip="标记完成" />
                    <StackPanel Grid.Column="1" Margin="5,0,2,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="11.8" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#E6EDF6" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                            <Setter Property="Foreground" Value="#6A7688" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding DueCompact}" FontSize="8.8" Margin="0,2,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#74849A" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource CoralBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AgendaTemplate">
            <Border x:Name="AgendaRoot" Background="Transparent" Padding="2,4" Cursor="Hand" MouseLeftButtonUp="TaskRow_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding TimeShort}" FontSize="10.5" FontFamily="{StaticResource NumberFont}"
                               Foreground="#93A2B8" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Width="3" Height="22" CornerRadius="2"
                            Background="{Binding QuadrantBrush}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Margin="8,0,4,0" VerticalAlignment="Center">
                        <TextBlock x:Name="AgendaTitle" Text="{Binding Title}" FontSize="12" Foreground="#E8EFF8"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding QuadrantLabel}" FontSize="9" Foreground="#6F7E93" Margin="0,2,0,0" />
                    </StackPanel>
                    <CheckBox Grid.Column="3" Style="{StaticResource TaskCheck}" IsChecked="{Binding IsDone, Mode=TwoWay}"
                              VerticalAlignment="Center" Click="TaskCheck_Click" ToolTip="标记完成" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter TargetName="AgendaTitle" Property="TextDecorations" Value="Strikethrough" />
                    <Setter TargetName="AgendaTitle" Property="Foreground" Value="#6A7688" />
                    <Setter TargetName="AgendaRoot" Property="Opacity" Value="0.58" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="AllTaskTemplate">
            <Border Background="Transparent" Padding="2,6" Cursor="Hand" MouseLeftButtonUp="TaskRow_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Style="{StaticResource TaskCheck}" IsChecked="{Binding IsDone, Mode=TwoWay}"
                              VerticalAlignment="Center" Click="TaskCheck_Click" />
                    <StackPanel Grid.Column="1" Margin="6,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#E8EFF8" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                            <Setter Property="Foreground" Value="#6A7688" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Ellipse Width="5" Height="5" Fill="{Binding QuadrantBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding QuadrantLabel}" FontSize="9" Foreground="#6F7E93" Margin="5,0,0,0" />
                            <TextBlock Text="{Binding DueCompact}" FontSize="9" Foreground="#7C8AA0" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="9"
                               Foreground="#4F5E73" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 桌面卡片主体 -->
        <Border x:Name="Shell" CornerRadius="22" BorderThickness="1"
                BorderBrush="#26FFFFFF" ClipToBounds="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F5172030" Offset="0" />
                    <GradientStop Color="#F50E141F" Offset="0.55" />
                    <GradientStop Color="#F40B1018" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.45" Color="#000000" />
            </Border.Effect>
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="新建任务" Click="ContextNewTask_Click" />
                    <MenuItem Header="全部任务" Click="ContextAllTasks_Click" />
                    <MenuItem x:Name="ContextDesktopModeItem" Header="切换到悬浮模式" Click="ContextDesktopMode_Click" />
                    <MenuItem x:Name="ContextTopmostItem" Header="窗口置顶" Click="ContextTopmost_Click" />
                    <MenuItem Header="隐藏到托盘" Click="ContextHide_Click" />
                    <MenuItem Header="退出云笺" Click="ContextExit_Click" />
                </ContextMenu>
            </Border.ContextMenu>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 顶部 -->
                <Grid x:Name="HeaderArea" Grid.Row="0" Margin="22,16,18,4" Background="Transparent"
                      MouseLeftButtonDown="Header_MouseLeftButtonDown"
                      MouseMove="Header_MouseMove"
                      MouseLeftButtonUp="Header_MouseLeftButtonUp">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderDateText" Text="11月20日 · 星期五" FontSize="10.5"
                                       Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" />
                            <Border Width="3" Height="3" CornerRadius="2" Background="#3E4E63" Margin="7,0" />
                            <TextBlock x:Name="HeaderClockText" Text="14:52" FontSize="10.5"
                                       FontFamily="{StaticResource NumberFont}" Foreground="#6F7E93" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,-4,-4,0">
                            <Button Style="{StaticResource IconButton}" Content="&#xE921;"
                                    FontFamily="{StaticResource IconFont}" FontSize="11"
                                    ToolTip="隐藏到系统托盘 (Ctrl+Alt+M)" Click="HideButton_Click" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE713;"
                                    FontFamily="{StaticResource IconFont}" FontSize="13"
                                    ToolTip="设置" Click="SettingsButton_Click" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="云笺" FontSize="27" FontWeight="Bold" Foreground="#F4F9FD" />
                            <Border Width="5" Height="5" CornerRadius="3" Background="{StaticResource AccentBrush}"
                                    VerticalAlignment="Bottom" Margin="4,0,0,11" />
                            <TextBlock Text="DESKTOP MEMO" FontFamily="Segoe UI" FontSize="7.5"
                                       Foreground="#4F6076" VerticalAlignment="Center" Margin="9,8,0,0" />
                        </StackPanel>
                        <Border x:Name="NextDueChip" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="#0EFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1"
                                CornerRadius="10" Padding="9,5" MaxWidth="176">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="5" Height="5" Fill="{StaticResource AmberBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="NextDueText" Text="今天没有截止任务" FontSize="9"
                                           Foreground="#93A2B8" Margin="5,0,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,7,0,0">
                        <TextBlock x:Name="HeaderSummaryText" Text="今天还有 0 件事" FontSize="10.5"
                                   Foreground="#8291A6" />
                        <TextBlock x:Name="HeaderProgressText" HorizontalAlignment="Right" FontSize="10"
                                   Foreground="#5E6E84" />
                    </Grid>
                </Grid>

                <!-- 导航 -->
                <Border Grid.Row="1" Margin="16,8,16,4" Height="42" CornerRadius="13"
                        Background="#0BFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" Padding="3">
                    <UniformGrid Columns="3">
                        <RadioButton x:Name="NavQuadrant" Style="{StaticResource NavTab}" GroupName="Nav"
                                     Content="四象限" IsChecked="True" Checked="Nav_Checked" Tag="quadrant" />
                        <RadioButton x:Name="NavCalendar" Style="{StaticResource NavTab}" GroupName="Nav"
                                     Content="日历日程" Checked="Nav_Checked" Tag="calendar" />
                        <RadioButton x:Name="NavPomodoro" Style="{StaticResource NavTab}" GroupName="Nav"
                                     Content="番茄专注" Checked="Nav_Checked" Tag="pomodoro" />
                    </UniformGrid>
                </Border>

                <!-- 内容 -->
                <Grid Grid.Row="2" Margin="16,6,16,2">

                    <!-- 四象限 -->
                    <Grid x:Name="QuadrantView">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="2,0,0,7">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="任务汇总" FontSize="12.5" FontWeight="SemiBold" Foreground="#DFE8F3" />
                                <Border Background="#12FFFFFF" CornerRadius="7" Padding="7,2" Margin="8,0,0,0">
                                    <TextBlock x:Name="PendingCountText" Text="0 项待办" FontSize="9" Foreground="#8C9BB0" />
                                </Border>
                                <TextBlock x:Name="CompletedCountText" Text="今日完成 0" FontSize="9"
                                           Foreground="#5F6F85" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="AllTasksButton" Style="{StaticResource TextButton}" Content="全部任务"
                                        Click="AllTasksButton_Click" />
                                <Button Style="{StaticResource SmallAccentButton}" Content="+ 新建任务"
                                        Margin="4,0,0,0" Click="AddTaskButton_Click" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Margin="0,0,5,5" CornerRadius="15"
                                    Background="#0CFFFFFF" BorderBrush="#20FF7A7A" BorderThickness="1">
                                <Grid Margin="12,10,10,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource CoralBrush}" />
                                            <TextBlock Text="重要 · 紧急" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="#F0DEDE" Margin="6,0,0,0" />
                                        </StackPanel>
                                        <TextBlock x:Name="Q1Count" Text="0" HorizontalAlignment="Right"
                                                   FontSize="11" FontFamily="{StaticResource NumberFont}" Foreground="#B67C7C" />
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,6,0,0">
                                        <ScrollViewer VerticalContentAlignment="Top" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="Q1List" ItemTemplate="{StaticResource TaskMiniTemplate}" />
                                        </ScrollViewer>
                                        <TextBlock x:Name="Q1Empty" Text="没有燃眉之急" FontSize="9.5"
                                                   Foreground="#4F5D71" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" TextAlignment="Center" IsHitTestVisible="False" />
                                    </Grid>
                                    <TextBlock Grid.Row="2" Text="先处理 · 别让火继续烧" FontSize="8.5"
                                               Foreground="#4B596D" Margin="1,4,0,0" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="1" Margin="5,0,0,5" CornerRadius="15"
                                    Background="#0CFFFFFF" BorderBrush="#206EE7D8" BorderThickness="1">
                                <Grid Margin="12,10,10,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" />
                                            <TextBlock Text="重要 · 不紧急" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="#D8EEEB" Margin="6,0,0,0" />
                                        </StackPanel>
                                        <TextBlock x:Name="Q2Count" Text="0" HorizontalAlignment="Right"
                                                   FontSize="11" FontFamily="{StaticResource NumberFont}" Foreground="#79B7AD" />
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,6,0,0">
                                        <ScrollViewer VerticalContentAlignment="Top" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="Q2List" ItemTemplate="{StaticResource TaskMiniTemplate}" />
                                        </ScrollViewer>
                                        <TextBlock x:Name="Q2Empty" Text="长期价值放这里" FontSize="9.5"
                                                   Foreground="#4F5D71" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" TextAlignment="Center" IsHitTestVisible="False" />
                                    </Grid>
                                    <TextBlock Grid.Row="2" Text="安排固定时间 · 持续投入" FontSize="8.5"
                                               Foreground="#4B596D" Margin="1,4,0,0" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Margin="0,5,5,0" CornerRadius="15"
                                    Background="#0CFFFFFF" BorderBrush="#20FFC46B" BorderThickness="1">
                                <Grid Margin="12,10,10,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource AmberBrush}" />
                                            <TextBlock Text="紧急 · 不重要" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="#EDE4D4" Margin="6,0,0,0" />
                                        </StackPanel>
                                        <TextBlock x:Name="Q3Count" Text="0" HorizontalAlignment="Right"
                                                   FontSize="11" FontFamily="{StaticResource NumberFont}" Foreground="#B09365" />
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,6,0,0">
                                        <ScrollViewer VerticalContentAlignment="Top" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="Q3List" ItemTemplate="{StaticResource TaskMiniTemplate}" />
                                        </ScrollViewer>
                                        <TextBlock x:Name="Q3Empty" Text="尽量委托出去" FontSize="9.5"
                                                   Foreground="#4F5D71" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" TextAlignment="Center" IsHitTestVisible="False" />
                                    </Grid>
                                    <TextBlock Grid.Row="2" Text="委托 · 简化 · 别全部揽下" FontSize="8.5"
                                               Foreground="#4B596D" Margin="1,4,0,0" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="1" Margin="5,5,0,0" CornerRadius="15"
                                    Background="#0CFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                <Grid Margin="12,10,10,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource SlateBrush}" />
                                            <TextBlock Text="不紧急 · 不重要" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="#D5DCE6" Margin="6,0,0,0" />
                                        </StackPanel>
                                        <TextBlock x:Name="Q4Count" Text="0" HorizontalAlignment="Right"
                                                   FontSize="11" FontFamily="{StaticResource NumberFont}" Foreground="#77869A" />
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,6,0,0">
                                        <ScrollViewer VerticalContentAlignment="Top" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="Q4List" ItemTemplate="{StaticResource TaskMiniTemplate}" />
                                        </ScrollViewer>
                                        <TextBlock x:Name="Q4Empty" Text="留白也很好" FontSize="9.5"
                                                   Foreground="#4F5D71" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" TextAlignment="Center" IsHitTestVisible="False" />
                                    </Grid>
                                    <TextBlock Grid.Row="2" Text="有空再做 · 或者果断放弃" FontSize="8.5"
                                               Foreground="#4B596D" Margin="1,4,0,0" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- 日历 -->
                    <Grid x:Name="CalendarView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="2,0,0,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="MonthText" Text="2026年11月" FontSize="15" FontWeight="SemiBold"
                                           Foreground="#E7EEF8" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Width="24" Height="24"
                                        FontFamily="{StaticResource IconFont}" FontSize="9" Margin="6,0,0,0"
                                        ToolTip="上个月" Click="PrevMonth_Click" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE76C;" Width="24" Height="24"
                                        FontFamily="{StaticResource IconFont}" FontSize="9"
                                        ToolTip="下个月" Click="NextMonth_Click" />
                            </StackPanel>
                            <Button Style="{StaticResource TextButton}" Content="回到今天" HorizontalAlignment="Right"
                                    Click="TodayButton_Click" />
                        </Grid>

                        <UniformGrid Grid.Row="1" Columns="7" Margin="2,6,2,3">
                            <TextBlock Text="一" FontSize="9" Foreground="#66768C" HorizontalAlignment="Center" />
                            <TextBlock Text="二" FontSize="9" Foreground="#66768C" HorizontalAlignment="Center" />
                            <TextBlock Text="三" FontSize="9" Foreground="#66768C" HorizontalAlignment="Center" />
                            <TextBlock Text="四" FontSize="9" Foreground="#66768C" HorizontalAlignment="Center" />
                            <TextBlock Text="五" FontSize="9" Foreground="#66768C" HorizontalAlignment="Center" />
                            <TextBlock Text="六" FontSize="9" Foreground="#66768C" HorizontalAlignment="Center" />
                            <TextBlock Text="日" FontSize="9" Foreground="#66768C" HorizontalAlignment="Center" />
                        </UniformGrid>

                        <Border Grid.Row="2" Background="#08FFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1"
                                CornerRadius="13" Padding="5,4">
                            <UniformGrid x:Name="CalendarGrid" Columns="7" Rows="6" />
                        </Border>

                        <Grid Grid.Row="3" Margin="2,8,0,3">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="AgendaDateText" Text="11月20日 · 星期五" FontSize="12"
                                           FontWeight="SemiBold" Foreground="#E1EAF5" />
                                <Border Background="#12FFFFFF" CornerRadius="7" Padding="7,2" Margin="8,0,0,0">
                                    <TextBlock x:Name="AgendaCountText" Text="0 项安排" FontSize="9" Foreground="#8494AA" />
                                </Border>
                            </StackPanel>
                            <Button Style="{StaticResource SmallAccentButton}" Content="+ 添加日程" HorizontalAlignment="Right"
                                    Click="AddAgendaButton_Click" />
                        </Grid>

                        <Grid Grid.Row="4" Margin="0,2,0,0">
                            <ScrollViewer VerticalContentAlignment="Top" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="AgendaList" ItemTemplate="{StaticResource AgendaTemplate}" />
                            </ScrollViewer>
                            <StackPanel x:Name="AgendaEmpty" VerticalAlignment="Center" HorizontalAlignment="Center"
                                        IsHitTestVisible="False" Margin="0,0,0,20">
                                <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="24"
                                           Foreground="#33445A" HorizontalAlignment="Center" />
                                <TextBlock Text="这一天还没有安排" FontSize="10.5" Foreground="#5E6E84"
                                           Margin="0,8,0,0" HorizontalAlignment="Center" />
                                <TextBlock Text="点击右上角「添加日程」，给任务设一个截止时间" FontSize="8.5"
                                           Foreground="#455469" Margin="0,4,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- 番茄钟 -->
                    <Grid x:Name="PomodoroView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" HorizontalAlignment="Center" Background="#0CFFFFFF"
                                BorderBrush="#16FFFFFF" BorderThickness="1" CornerRadius="11" Padding="3">
                            <UniformGrid Columns="3">
                                <RadioButton x:Name="FocusModeTab" Style="{StaticResource NavTab}" GroupName="TimerMode"
                                             Content="专注" Width="78" Height="28" IsChecked="True" Checked="TimerMode_Checked" Tag="focus" />
                                <RadioButton x:Name="ShortModeTab" Style="{StaticResource NavTab}" GroupName="TimerMode"
                                             Content="短休息" Width="78" Height="28" Checked="TimerMode_Checked" Tag="short" />
                                <RadioButton x:Name="LongModeTab" Style="{StaticResource NavTab}" GroupName="TimerMode"
                                             Content="长休息" Width="78" Height="28" Checked="TimerMode_Checked" Tag="long" />
                            </UniformGrid>
                        </Border>

                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <Grid Width="226" Height="226" HorizontalAlignment="Center">
                                <controls:ProgressRing x:Name="TimerRing" Progress="0" StrokeThickness="9"
                                                       TrackBrush="#1AFFFFFF" AccentBrush="{StaticResource AccentBrush}" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="TimerModeLabel" Text="专 注" FontSize="9.5" Foreground="#7F90A6"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="TimerText" Text="25:00" FontSize="47" FontFamily="{StaticResource NumberFont}"
                                               FontWeight="Light" Foreground="#F4F9FD" HorizontalAlignment="Center"
                                               Margin="0,2,0,2" />
                                    <StackPanel x:Name="SessionDotsPanel" Orientation="Horizontal" HorizontalAlignment="Center"
                                                Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>

                            <Grid Width="306" Margin="0,12,0,0" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="关联任务" FontSize="10" Foreground="#718198" VerticalAlignment="Center"
                                           Margin="0,0,9,0" />
                                <ComboBox x:Name="FocusTaskCombo" Grid.Column="1" Style="{StaticResource DarkCombo}"
                                          DisplayMemberPath="Title" SelectionChanged="FocusTaskCombo_SelectionChanged" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,13,0,0">
                                <Button x:Name="TimerToggleButton" Style="{StaticResource PrimaryButton}" Width="128"
                                        Content="开始专注" Click="TimerToggle_Click" />
                                <Button Style="{StaticResource SecondaryButton}" Width="40" Height="38" Margin="8,0,0,0"
                                        FontFamily="{StaticResource IconFont}" FontSize="12" Content="&#xE72C;"
                                        ToolTip="重置本阶段" Click="TimerReset_Click" />
                                <Button Style="{StaticResource SecondaryButton}" Width="40" Height="38" Margin="6,0,0,0"
                                        FontFamily="{StaticResource IconFont}" FontSize="12" Content="&#xE893;"
                                        ToolTip="跳过本阶段" Click="TimerSkip_Click" />
                            </StackPanel>
                        </StackPanel>

                        <Grid Grid.Row="2" Margin="2,0,2,0">
                            <TextBlock x:Name="FocusStatsText" Text="今日专注 0 次 · 0 分钟" FontSize="9.5"
                                       Foreground="#718198" />
                            <TextBlock x:Name="CycleText" Text="第 1 轮" FontSize="9.5" Foreground="#5C6C82"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Grid>
                </Grid>

                <!-- 底部状态 -->
                <Grid Grid.Row="3" Margin="22,0,20,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="4" Height="4" Fill="{StaticResource AccentBrush}" Opacity="0.8" />
                        <TextBlock x:Name="SaveStatusText" Text="已保存到本地" FontSize="8.5" Foreground="#52627A"
                                   Margin="5,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="Ctrl+Alt+M 呼出 / 隐藏" FontSize="8.5" Foreground="#425168"
                               HorizontalAlignment="Right" />
                </Grid>
            </Grid>
        </Border>

        <!-- 全部任务 -->
        <Border x:Name="AllTasksOverlay" Visibility="Collapsed" Background="#B0060A10" CornerRadius="22"
              MouseLeftButtonDown="OverlayBackdrop_Click">
            <Border Width="356" MaxHeight="620" VerticalAlignment="Center" Background="#FC151D2A"
                    BorderBrush="#2AFFFFFF" BorderThickness="1" CornerRadius="20" Padding="20,18"
                    MouseLeftButtonDown="OverlayCard_Click">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.5" Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="全部任务" Style="{StaticResource OverlayTitle}" />
                            <TextBlock x:Name="AllTasksCountText" Text="0 项任务" FontSize="9.5"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontFamily="{StaticResource IconFont}"
                                FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Click="CloseAllTasks_Click" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,14,0,8">
                        <Border HorizontalAlignment="Left" Background="#0CFFFFFF" CornerRadius="10" Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="AllFilterPending" Style="{StaticResource NavTab}" Content="未完成"
                                             GroupName="AllFilter" Width="64" Height="26" IsChecked="True"
                                             Checked="AllFilter_Checked" Tag="pending" />
                                <RadioButton x:Name="AllFilterDone" Style="{StaticResource NavTab}" Content="已完成"
                                             GroupName="AllFilter" Width="64" Height="26"
                                             Checked="AllFilter_Checked" Tag="done" />
                                <RadioButton x:Name="AllFilterEverything" Style="{StaticResource NavTab}" Content="全部"
                                             GroupName="AllFilter" Width="58" Height="26"
                                             Checked="AllFilter_Checked" Tag="all" />
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource SmallAccentButton}" Content="+ 新建" HorizontalAlignment="Right"
                                Click="AddFromAllTasks_Click" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <ScrollViewer VerticalContentAlignment="Top" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="AllTasksList" ItemTemplate="{StaticResource AllTaskTemplate}" />
                        </ScrollViewer>
                        <TextBlock x:Name="AllTasksEmpty" Text="这里还没有任务" FontSize="10" Foreground="#52627A"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <TextBlock Text="点击任务可编辑 · 勾选完成" FontSize="8.5" Foreground="#425168"
                                   VerticalAlignment="Center" />
                        <Button Style="{StaticResource SecondaryButton}" Content="关闭" Width="76" Height="32"
                                HorizontalAlignment="Right" Click="CloseAllTasks_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- 新建 / 编辑任务 -->
        <Border x:Name="TaskEditor" Visibility="Collapsed" Background="#B0060A10" CornerRadius="22"
              MouseLeftButtonDown="OverlayBackdrop_Click">
            <Border Margin="18" MaxHeight="650" VerticalAlignment="Center" Background="#FC151D2A"
                    BorderBrush="#2AFFFFFF" BorderThickness="1" CornerRadius="20" Padding="20,18"
                    MouseLeftButtonDown="OverlayCard_Click">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.5" Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="TaskEditorTitle" Text="新建任务" Style="{StaticResource OverlayTitle}" />
                            <TextBlock Text="把事情写下来，大脑就可以放下了" FontSize="9" Foreground="#62728A" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontFamily="{StaticResource IconFont}"
                                FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Click="CloseTaskEditor_Click" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" Margin="0,15,0,4" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" MaxHeight="480">
                        <StackPanel>
                            <TextBlock Text="任务内容" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="TaskTitleBox" Style="{StaticResource InputBox}" Height="38"
                                     MaxLength="120" KeyDown="TaskEditor_KeyDown" />

                            <TextBlock Text="备注" Style="{StaticResource FieldLabel}" Margin="1,12,0,6" />
                            <TextBox x:Name="TaskNotesBox" Style="{StaticResource MultilineInput}" MaxLength="600" />

                            <Grid Margin="1,13,0,6">
                                <TextBlock Text="截止时间" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                                <CheckBox x:Name="DueEnabledCheck" Style="{StaticResource PillToggle}" Content="设置截止"
                                          HorizontalAlignment="Right" Padding="9,3" FontSize="9.5"
                                          Checked="DueEnabled_Changed" Unchecked="DueEnabled_Changed" />
                            </Grid>
                            <Grid x:Name="DueFieldsGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DueDateBox" Style="{StaticResource InputBox}" Height="34"
                                         ToolTip="日期格式：yyyy-MM-dd" />
                                <TextBox x:Name="DueTimeBox" Grid.Column="1" Style="{StaticResource InputBox}" Height="34"
                                         Margin="7,0,0,0" MaxLength="5" ToolTip="24 小时制，例如 18:30"
                                         TextChanged="DueTimeBox_TextChanged" />
                                <TextBlock Grid.Column="2" Text="时:分" FontSize="9" Foreground="#5E6E84"
                                           VerticalAlignment="Center" Margin="7,0,0,0" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <Button Style="{StaticResource TextButton}" Content="今天" Click="DueQuickToday_Click" />
                                <Button Style="{StaticResource TextButton}" Content="明天" Click="DueQuickTomorrow_Click" />
                                <Button Style="{StaticResource TextButton}" Content="后天" Click="DueQuickDayAfter_Click" />
                                <Button Style="{StaticResource TextButton}" Content="18:00" Click="DueQuickEvening_Click" />
                                <Button Style="{StaticResource TextButton}" Content="09:00" Click="DueQuickMorning_Click" />
                            </StackPanel>

                            <TextBlock Text="优先级" Style="{StaticResource FieldLabel}" Margin="1,12,0,7" />
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="ImportantCheck" Style="{StaticResource PillToggle}" Content="重要"
                                          Checked="Priority_Changed" Unchecked="Priority_Changed" />
                                <CheckBox x:Name="UrgentCheck" Style="{StaticResource PillToggle}" Content="紧急"
                                          Margin="8,0,0,0" Checked="Priority_Changed" Unchecked="Priority_Changed" />
                                <TextBlock Text="重要看价值，紧急看时间" FontSize="8.5" Foreground="#4E5E74"
                                           VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>

                            <Border Background="#0BFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1"
                                    CornerRadius="11" Padding="11,9" Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="QuadrantPreviewDot" Width="7" Height="7" Fill="{StaticResource CoralBrush}"
                                             VerticalAlignment="Center" />
                                    <TextBlock x:Name="QuadrantPreviewText" Text="将归入：重要 · 紧急" FontSize="10"
                                               Foreground="#B9C6D8" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="TaskEditorError" Text="" FontSize="9.5" Foreground="{StaticResource CoralBrush}"
                                       Margin="1,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Button x:Name="TaskEditorDeleteButton" Style="{StaticResource DangerButton}" Content="删除任务"
                                HorizontalAlignment="Left" Click="DeleteTask_Click" Visibility="Collapsed" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource SecondaryButton}" Content="取消" Width="72" Height="34"
                                    Click="CloseTaskEditor_Click" />
                            <Button x:Name="TaskEditorSaveButton" Style="{StaticResource PrimaryButton}" Content="保存"
                                    Width="84" Height="34" Margin="8,0,0,0" Click="SaveTask_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- 设置 -->
        <Border x:Name="SettingsOverlay" Visibility="Collapsed" Background="#B0060A10" CornerRadius="22"
              MouseLeftButtonDown="OverlayBackdrop_Click">
            <Border Margin="18" MaxHeight="620" VerticalAlignment="Center" Background="#FC151D2A"
                    BorderBrush="#2AFFFFFF" BorderThickness="1" CornerRadius="20" Padding="20,18"
                    MouseLeftButtonDown="OverlayCard_Click">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.5" Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="设置" Style="{StaticResource OverlayTitle}" />
                            <TextBlock Text="让云笺更适合你的桌面" FontSize="9" Foreground="#62728A" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontFamily="{StaticResource IconFont}"
                                FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Click="CloseSettings_Click" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" Margin="0,6,0,4" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" MaxHeight="470">
                        <StackPanel>
                            <TextBlock Text="桌面组件" Style="{StaticResource SectionLabel}" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="固定在桌面" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="嵌入壁纸层，不遮挡其他窗口；关闭后成为悬浮窗口" Style="{StaticResource SettingDesc}" />
                                </StackPanel>
                                <CheckBox x:Name="DesktopModeSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                          VerticalAlignment="Center" Checked="DesktopMode_Changed" Unchecked="DesktopMode_Changed" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="窗口置顶" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="悬浮模式下始终显示在其他窗口上方" Style="{StaticResource SettingDesc}" />
                                </StackPanel>
                                <CheckBox x:Name="AlwaysOnTopSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                          VerticalAlignment="Center" Checked="AlwaysOnTop_Changed" Unchecked="AlwaysOnTop_Changed" />
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="开机自启" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="登录 Windows 后自动出现在桌面" Style="{StaticResource SettingDesc}" />
                                </StackPanel>
                                <CheckBox x:Name="AutoStartSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                          VerticalAlignment="Center" Checked="AutoStart_Changed" Unchecked="AutoStart_Changed" />
                            </Grid>

                            <TextBlock Text="番茄钟" Style="{StaticResource SectionLabel}" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="完成提示音" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="专注或休息结束时播放轻提示音" Style="{StaticResource SettingDesc}" />
                                </StackPanel>
                                <CheckBox x:Name="SoundSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                          VerticalAlignment="Center" Checked="Sound_Changed" Unchecked="Sound_Changed" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="自动开始下一阶段" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="专注结束后自动进入休息倒计时" Style="{StaticResource SettingDesc}" />
                                </StackPanel>
                                <CheckBox x:Name="AutoNextSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                          VerticalAlignment="Center" Checked="AutoNext_Changed" Unchecked="AutoNext_Changed" />
                            </Grid>
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,7,0">
                                    <TextBlock Text="专注（分钟）" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="FocusMinutesBox" Style="{StaticResource InputBox}" Height="32"
                                             FontFamily="{StaticResource NumberFont}" LostFocus="Duration_LostFocus" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,7,0">
                                    <TextBlock Text="短休（分钟）" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="ShortBreakBox" Style="{StaticResource InputBox}" Height="32"
                                             FontFamily="{StaticResource NumberFont}" LostFocus="Duration_LostFocus" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="长休（分钟）" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="LongBreakBox" Style="{StaticResource InputBox}" Height="32"
                                             FontFamily="{StaticResource NumberFont}" LostFocus="Duration_LostFocus" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="数据" Style="{StaticResource SectionLabel}" />
                            <Border Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1"
                                    CornerRadius="10" Padding="10,8">
                                <StackPanel>
                                    <TextBlock Text="本地存档" Style="{StaticResource SettingTitle}" FontSize="10.5" />
                                    <TextBlock x:Name="DataPathText" FontSize="8.5" Foreground="#5E6E84"
                                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <Button Style="{StaticResource TextButton}" Content="打开数据文件夹"
                                        Click="OpenDataFolder_Click" />
                                <Button Style="{StaticResource TextButton}" Content="重置窗口位置"
                                        Click="ResetPosition_Click" />
                            </StackPanel>

                            <TextBlock x:Name="VersionText" Text="云笺 v1.0 · 本地优先，数据不上传" FontSize="8.5"
                                       Foreground="#48586E" Margin="1,14,0,0" />
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Button Style="{StaticResource TextButton}" Content="退出云笺" Foreground="{StaticResource CoralBrush}"
                                HorizontalAlignment="Left" Click="ExitApp_Click" />
                        <Button Style="{StaticResource PrimaryButton}" Content="完成" Width="82" Height="34"
                                HorizontalAlignment="Right" Click="CloseSettings_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- 轻提示 -->
        <Border x:Name="ToastBar" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="18,0,18,44"
                Background="#F5232D3D" BorderBrush="#2EFFFFFF" BorderThickness="1" CornerRadius="12"
                Padding="14,9" Opacity="0" IsHitTestVisible="False" Panel.ZIndex="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.4" Color="#000000" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="ToastText" Text="" FontSize="10.5" Foreground="#DFE8F3" Margin="7,0,0,0"
                           VerticalAlignment="Center" />
                <Button x:Name="ToastUndoButton" Style="{StaticResource TextButton}" Content="撤销" FontSize="10"
                        Margin="6,0,0,0" Visibility="Collapsed" Click="ToastUndo_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
